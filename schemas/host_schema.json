{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PASM Host Definition",
  "description": "Schema for host.yaml (one host integration component per file).",
  "type": "object",
  "required": [
    "metadata",
    "state",
    "interfaces",
    "behavior",
    "coding"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "type",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "model": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "clock_hz": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_ *]*$"
          },
          "initial": {
            "type": "string"
          }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "required": [
        "callbacks",
        "handlers",
        "signals"
      ],
      "additionalProperties": false,
      "properties": {
        "callbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "returns": {
                "type": "string"
              }
            }
          }
        },
        "handlers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "behavior": {
      "type": "object",
      "required": [
        "snippets",
        "callback_handlers",
        "handler_bodies"
      ],
      "additionalProperties": false,
      "properties": {
        "snippets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "callback_handlers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "handler_bodies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "coding": {
      "type": "object",
      "required": [
        "headers",
        "include_paths",
        "linked_libraries",
        "library_paths"
      ],
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linked_libraries": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "path"
                    ]
                  }
                ]
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "common": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "name"
                        ]
                      },
                      {
                        "required": [
                          "path"
                        ]
                      }
                    ]
                  }
                },
                "win32": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "name"
                        ]
                      },
                      {
                        "required": [
                          "path"
                        ]
                      }
                    ]
                  }
                },
                "win64": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "name"
                        ]
                      },
                      {
                        "required": [
                          "path"
                        ]
                      }
                    ]
                  }
                },
                "linux": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "name"
                        ]
                      },
                      {
                        "required": [
                          "path"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        "library_paths": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "common": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "win32": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "win64": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "linux": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "backend": {
      "type": "object",
      "required": [
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cartridge_picker_font_scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "cassette_picker_font_scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "automation": {
      "type": "object",
      "description": "Host-owned automation metadata such as framebuffer capture and input backend behavior.",
      "additionalProperties": true,
      "properties": {
        "screen": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "framebuffer": {
              "type": "object",
              "additionalProperties": true
            },
            "text_views": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "columns",
                  "rows"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rows": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
